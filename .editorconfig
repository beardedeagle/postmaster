# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json,jsonc,md,nix}]
indent_size = 2

[*.md]
# Markdown may use trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1,cmd,bat}]
# Windows-native scripts use CRLF, matching .gitattributes.
end_of_line = crlf
