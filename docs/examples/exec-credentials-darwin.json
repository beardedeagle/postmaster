{
  "mode": "credentials",
  "credential_keys": [
    "DATABASE_URL",
    "REDIS_URL"
  ],
  "secrets_dir": "/private/var/run/postmaster/myapp",
  "sockets": {
    "DATABASE_URL": {
      "path": "/private/var/run/postmaster-credd/myapp/DATABASE_URL.sock",
      "protocol": "framed",
      "server_uid": 0
    },
    "REDIS_URL": {
      "path": "/private/var/run/postmaster-credd/myapp/REDIS_URL.sock",
      "protocol": "framed",
      "server_uid": 0
    }
  },
  "verify_ramdisk": "/private/var/run/postmaster"
}
