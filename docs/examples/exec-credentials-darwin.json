{
  "mode": "credentials",
  "credential_keys": [
    "DATABASE_URL",
    "REDIS_URL"
  ],
  "secrets_dir": "/private/var/run/postmaster/myapp",
  "sockets": {
    "DATABASE_URL": "/private/var/run/postmaster-credd/myapp/DATABASE_URL.sock",
    "REDIS_URL": "/private/var/run/postmaster-credd/myapp/REDIS_URL.sock"
  },
  "verify_ramdisk": "/private/var/run/postmaster"
}
