# Rust build output
/postmaster/target/
target/

# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# CRITICAL: dotenvx private keys. This repo's entire threat model is
# "encrypted .env values may be committed, private keys never are."
# Never remove these two lines.
.env.keys
*.env.keys

# Editor and OS files
.DS_Store

# mdBook build output (docs/)
/docs/book/

# generated by the docs recipe from /CHANGELOG.md
docs/src/changelog.md

# Additional ignores
.omc/
target/
docs/superpowers/
.superpowers/
